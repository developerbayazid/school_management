<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record model="ir.module.category" id="module_category_school_management">
        <field name="name">School Management</field>
        <field name="sequence">10</field>
    </record>

    <record model="res.groups.privilege" id="res_groups_privilege_school_management">
        <field name="name">School Management</field>
        <field name="sequence">10</field>
        <field name="category_id" ref="school_management.module_category_school_management"/>
    </record>

    <record id="group_school_management_user" model="res.groups">
        <field name="name">User</field>
        <field name="sequence">10</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="privilege_id" ref="res_groups_privilege_school_management"/>
    </record>

    <record id="group_school_management_admin" model="res.groups">
        <field name="name">Administrator</field>
        <field name="sequence">10</field>
        <field name="implied_ids" eval="[(4, ref('group_school_management_user'))]"/>
        <field name="privilege_id" ref="res_groups_privilege_school_management"/>
    </record>

</odoo>
