<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- View student.information View List -->
    <record id="view_student_information_list" model="ir.ui.view">
        <field name="name">view.student.information.list</field>
        <field name="model">student.information</field>
        <field name="arch" type="xml">
            <list string="Student Information" decoration-muted="status == 'draft'" decoration-success="status=='confirmed'">
                <field name="name"/>
                <field name="roll_number"/>
                <field name="phone_number"/>
                <field name="email"/>
                <field name="birth_certificate"/>
                <field name="status"/>
                <field name="number_of_documents"/>
                <field name="class_id"/>
            </list>
        </field>
    </record>

    <!-- View student.information form -->
    <record id="view_student_information_form" model="ir.ui.view">
        <field name="name">view.student.information.form</field>
        <field name="model">student.information</field>
        <field name="arch" type="xml">
            <form string="Student Information">
                <header>
                    <button string="Confirm Student" invisible="status != 'draft'" name="confirm_student" type="object" class="btn-primary"/>
                    <button string="Reset to Draft" invisible="status != 'confirmed'" name="reset_student" type="object" class="btn-secondary"/>
                    <field name="status" widget="statusbar"/>
                </header>
                <sheet>
                    <field name="student_image" widget="image" options="{'size': [130,200]}" class="float-end"/>
                    <group>
                        <group string="Basic Information">
                            <field name="name" readonly="status != 'draft'"/>
                            <field name="roll_number" readonly="status != 'draft'"/>
                            <field name="phone_number" readonly="status != 'draft'"/>
                            <field name="email" readonly="status != 'draft'"/>
                            <field name="birth_certificate" readonly="status != 'draft'"/>
                            <field name="address"/>
                            <field name="number_of_documents"/>
                            <field name="class_id"/>
                        </group>

                        <group string="Parents Information">
                            <field name="father_name" readonly="status != 'draft'"/>
                            <field name="mother_name" readonly="status != 'draft'"/>
                        </group>
                    </group>

                    <notebook>
                        <page name="study_history" string="Study History">
                            <field name="previous_record_ids" readonly="status != 'draft'">
                                <list editable="bottom">
                                    <field name="student_id" column_visible="1"/>
                                    <field name="others_school_id"/>
                                    <field name="passing_year"/>
                                    <field name="class_name"/>
                                </list>
                            </field>
                        </page>
                        <page name="student_documents" string="Attachments">
                            <group string="Upload Documents">
                                <field name="student_document_ids" widget="many2many_binary"/>
                            </group>
                        </page>
                        <page name="student_notes" string="Notes">
                            <group string="Student Notes">
                                <field name="student_notes"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter />
            </form>
        </field>
    </record>




    <!-- student.information kanban view -->
    <record id="view_student_information_kanban" model="ir.ui.view">
        <field name="name">view.student.information.kanban</field>
        <field name="model">student.information</field>
        <field name="arch" type="xml">
            <kanban sample="1">
                <field name="name"/>
                <field name="roll_number"/>
                <field name="email"/>
                <field name="phone_number"/>
                <field name="student_image"/>
                <field name="number_of_documents"/>
                <field name="class_id"/>
                <templates>
                    <t t-name="card" class="flex-row">
                        <aside class="o_kanban_aside_full">
                            <field name="student_image" class="w-100 h-auto m-0" widget="image" options="{'img_class': 'object-fit-contain w-100 h-100'}"/>
                        </aside>
                        <main class="ps-2">
                            <div class="mb-1">
                                <field name="name" class="mb-0 fw-bold fs-5"/>
                            </div>
                            
                            <div t-if="record.roll_number.raw_value">
                                <i class="fa fa-fw me-1 fa-id-card text-primary" title="Roll Number"/>
                                <field name="roll_number"/>
                            </div>
                            <div t-if="record.email.raw_value" class="text-truncate">
                                <i class="fa fa-fw me-1 fa-envelope text-primary" title="Email"/>
                                <field name="email"/>
                            </div>
                            <div t-if="record.phone_number.raw_value">
                                <i class="fa fa-fw me-1 fa-phone text-primary" title="Phone"/>
                                <field name="phone_number"/>
                            </div>
                            <div t-if="record.number_of_documents.raw_value">
                                <i class="fa fa-fw me-1 fa-files-o text-primary" title="Number Of Documents"/>
                                <field name="number_of_documents"/>
                            </div>
                            <div t-if="record.class_id.raw_value">
                                <i class="fa fa-fw me-1 fa-graduation-cap text-primary" title="Class"/>
                                <field name="class_id"/>
                            </div>
                            
                        </main>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    

