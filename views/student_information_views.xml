    <!-- model.name action window -->
    <record id="student_information_action" model="ir.actions.act_window">
        <field name="name">Student Information</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">student.information</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                Please Create your student information here.
            </p>
        </field>
    </record>


    <!-- This Menu Item will appear in the Upper bar, that's why It needs NO parent or action -->
    <menuitem id="school_management_menu_root" name="School Management" sequence="1"/>
    <!-- This Menu Item must have a parent and an action -->
    <menuitem id="student_information_menu_act" name="Student Information" parent="school_management_menu_root" action="student_information_action" sequence="1"/>

