<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- View class.information View List -->
    <record id="view_class_information_list" model="ir.ui.view">
        <field name="name">view.class.information.list</field>
        <field name="model">class.information</field>
        <field name="arch" type="xml">
            <list editable="top">
                <field name="name"/>
                <field name="class_teacher_id"/>
                <field name="number_of_seat"/>
            </list>
        </field>
    </record>

